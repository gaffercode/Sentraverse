# Sentraverse Neural: environment template.
# Copy this file to `.env.local` (git-ignored) and fill in only what you need.
# Never commit real values. Every variable is server-only and optional: the site builds and
# runs without any of them.

# Vera chat (Dify). Without the key, POST /api/vera/chat answers HTTP 500
# "Vera is not available right now."
DIFY_API_KEY=
# Optional override of the Dify endpoint. Default when empty: https://api.dify.ai/v1
DIFY_API_URL=

# Vera message limit (Upstash Redis REST). Set both or neither: without the pair the limit is
# counted in memory per server instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=
